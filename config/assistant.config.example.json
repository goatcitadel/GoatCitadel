{
  "environment": "local",
  "defaultToolProfile": "chat-agent",
  "dataDir": "./data",
  "transcriptsDir": "./data/transcripts",
  "auditDir": "./data/audit",
  "workspaceDir": "./workspace",
  "worktreesDir": "./.worktrees",
  "auth": {
    "mode": "none",
    "allowLoopbackBypass": false,
    "token": {
      "queryParam": "access_token"
    },
    "basic": {}
  },
  "approvalExplainer": {
    "enabled": true,
    "mode": "async",
    "minRiskLevel": "caution",
    "timeoutMs": 15000,
    "maxPayloadChars": 4000
  },
  "memory": {
    "enabled": true,
    "qmd": {
      "enabled": true,
      "applyToChat": true,
      "applyToOrchestration": true,
      "minPromptChars": 48,
      "maxContextTokens": 1400,
      "headroomTokens": 600,
      "maxTranscriptEvents": 80,
      "maxMemoryFiles": 36,
      "maxBytesPerFile": 64000,
      "allowedExtensions": [".md", ".txt", ".json", ".yaml", ".yml", ".log", ".ts", ".tsx", ".js", ".jsx"],
      "cacheTtlSeconds": 300,
      "distiller": {
        "timeoutMs": 12000,
        "fallbackCheapModel": "gpt-4.1-nano"
      }
    }
  },
  "web": {
    "firecrawl": {
      "enabled": true,
      "baseUrl": "http://127.0.0.1:3002",
      "apiKeyEnv": "FIRECRAWL_API_KEY",
      "timeoutMs": 20000,
      "defaultReadBackend": "firecrawl",
      "fallbackToNative": true
    }
  },
  "mesh": {
    "enabled": false,
    "mode": "lan",
    "discovery": {
      "mdns": true,
      "staticPeers": []
    },
    "security": {
      "joinTokenEnv": "GOATCITADEL_MESH_JOIN_TOKEN",
      "requireMtls": true,
      "tailnet": {
        "enabled": false
      }
    },
    "leases": {
      "ttlSeconds": 30
    },
    "replication": {
      "batchSize": 200
    }
  },
  "npu": {
    "enabled": false,
    "autoStart": false,
    "sidecar": {
      "baseUrl": "http://127.0.0.1:11440",
      "command": "python",
      "args": ["apps/npu-sidecar/server.py"],
      "healthPath": "/health",
      "modelsPath": "/v1/models",
      "startTimeoutMs": 20000,
      "requestTimeoutMs": 12000,
      "restartBudget": {
        "windowMs": 60000,
        "maxRestarts": 5,
        "backoffMs": 2000
      }
    }
  },
  "llamaCpp": {
    "enabled": false,
    "autoStart": false,
    "server": {
      "baseUrl": "http://127.0.0.1:8080/v1",
      "command": "llama-server",
      "extraArgs": [
        "--reasoning",
        "off"
      ],
      "healthPath": "/health",
      "modelsPath": "/v1/models",
      "startTimeoutMs": 20000,
      "requestTimeoutMs": 12000,
      "restartBudget": {
        "windowMs": 60000,
        "maxRestarts": 5,
        "backoffMs": 2000
      }
    },
    "launch": {
      "alias": "gemma-4-local",
      "ctxSize": 40960,
      "parallel": 1,
      "batchSize": 1024,
      "ubatchSize": 512,
      "flashAttention": true
    }
  },
  "database": {
    "driver": "postgres",
    "postgres": {
      "mode": "bundled",
      "port": 5432,
      "database": "goatcitadel",
      "ssl": "prefer",
      "pool": {
        "min": 0,
        "max": 10,
        "idleTimeoutMs": 30000,
        "connectionTimeoutMs": 10000
      },
      "migrationsTable": "schema_migrations"
    },
    "bundledPostgres": {
      "enabled": true,
      "dataDir": "./data/postgres",
      "port": 55432,
      "autoStart": true,
      "startTimeoutMs": 20000
    },
    "sqlite": {
      "cacheSizeKb": 65536,
      "tempStoreMemory": true,
      "walAutoCheckpointPages": 5000
    }
  },
  "sqlite": {
    "cacheSizeKb": 65536,
    "tempStoreMemory": true,
    "walAutoCheckpointPages": 5000
  },
  "durable": {
    "enabled": true,
    "diagnosticsEnabled": false,
    "executionEnabled": true,
    "chatAutoPromoteEnabled": true,
    "maxAttemptsDefault": 3
  },
  "features": {
    "durableKernelV1Enabled": true,
    "replayOverridesV1Enabled": false,
    "memoryLifecycleAdminV1Enabled": false,
    "memoryMaintenanceV1Enabled": false,
    "connectorDiagnosticsV1Enabled": false,
    "computerUseGuardrailsV1Enabled": true,
    "bankrBuiltinEnabled": false,
    "cronReviewQueueV1Enabled": false,
    "replayRegressionV1Enabled": true
  },
  "budgets": {
    "dailyUsdWarning": 10,
    "dailyUsdHardCap": 50,
    "sessionTokenHardCap": 120000
  }
}
