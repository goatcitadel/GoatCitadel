{
  "tools": {
    "profile": "chat-agent",
    "approvalMode": "approve_risky",
    "allow": [
      "session.*",
      "chat.*",
      "memory.*",
      "skills.*",
      "fs.read",
      "fs.list",
      "fs.stat",
      "file.read_range",
      "file.find",
      "code.search",
      "docs.*",
      "knowledge.*"
    ],
    "loopDetection": {
      "enabled": true,
      "historySize": 8,
      "warningThreshold": 3,
      "criticalThreshold": 4,
      "globalThreshold": 6,
      "detectors": {
        "repeated_same_call": true,
        "no_progress_polling": true,
        "ping_pong": true
      }
    },
    "deny": [
      "fs.write",
      "fs.delete",
      "fs.copy",
      "fs.move",
      "shell.exec",
      "mcp.invoke",
      "browser.cookies.get",
      "browser.storage.get",
      "calendar.create",
      "calendar.update",
      "calendar.delete"
    ]
  },
  "agents": {},
  "sandbox": {
    "writeJailRoots": ["./workspace", "./data", "./.worktrees"],
    "readOnlyRoots": ["./skills"],
    "readAccessMode": "approval_required",
    "networkAllowlist": [
      "discord.com",
      "chatgpt.com",
      "api.openai.com",
      "api.anthropic.com",
      "generativelanguage.googleapis.com",
      "api.minimax.io",
      "ai-gateway.vercel.sh",
      "openrouter.ai",
      "api.mistral.ai",
      "api.deepseek.com",
      "api.z.ai",
      "api.moonshot.ai",
      "api.perplexity.ai",
      "api.search.brave.com",
      "api.parallel.ai",
      "router.huggingface.co",
      "duckduckgo.com",
      "lite.duckduckgo.com",
      "www.bing.com",
      "www.google.com",
      "127.0.0.1",
      "localhost"
    ],
    "riskyShellPatterns": ["rm", "rmdir", "del", "format", "shutdown", "reboot", "git push", "git reset --hard"],
    "requireApprovalForRiskyShell": true,
    "riskyArgumentPatterns": [
      {
        "toolNamePattern": "*",
        "argumentPath": "command",
        "valuePatterns": ["terraform destroy", "pulumi destroy", "cdk destroy"]
      },
      { "toolNamePattern": "terraform.*", "argumentPath": "action", "valuePatterns": ["destroy"] },
      { "toolNamePattern": "pulumi.*", "argumentPath": "action", "valuePatterns": ["destroy"] }
    ]
  },
  "hooks": {
    "networkAllowlist": []
  }
}
