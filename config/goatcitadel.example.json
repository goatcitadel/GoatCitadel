{
  "version": 1,
  "assistant": {
    "environment": "local",
    "toolApprovalMode": "approve_risky",
    "dataDir": "./data",
    "transcriptsDir": "./data/transcripts",
    "auditDir": "./data/audit",
    "workspaceDir": "./workspace",
    "worktreesDir": "./.worktrees",
    "auth": {
      "mode": "none",
      "allowLoopbackBypass": false,
      "token": {
        "queryParam": "access_token"
      },
      "basic": {}
    },
    "approvalExplainer": {
      "enabled": true,
      "mode": "async",
      "minRiskLevel": "caution",
      "timeoutMs": 15000,
      "maxPayloadChars": 4000
    },
    "memory": {
      "enabled": true,
      "qmd": {
        "enabled": true,
        "applyToChat": true,
        "applyToOrchestration": true,
        "minPromptChars": 48,
        "maxContextTokens": 1400,
        "headroomTokens": 600,
        "maxTranscriptEvents": 80,
        "maxMemoryFiles": 36,
        "maxBytesPerFile": 64000,
        "allowedExtensions": [".md", ".txt", ".json", ".yaml", ".yml", ".log", ".ts", ".tsx", ".js", ".jsx"],
        "cacheTtlSeconds": 300,
        "distiller": {
          "timeoutMs": 12000,
          "fallbackCheapModel": "gpt-4.1-nano"
        }
      }
    },
    "web": {
      "firecrawl": {
        "enabled": true,
        "baseUrl": "http://127.0.0.1:3002",
        "apiKeyEnv": "FIRECRAWL_API_KEY",
        "timeoutMs": 20000,
        "defaultReadBackend": "firecrawl",
        "fallbackToNative": true
      }
    },
    "mesh": {
      "enabled": false,
      "mode": "lan",
      "discovery": {
        "mdns": true,
        "staticPeers": []
      },
      "security": {
        "joinTokenEnv": "GOATCITADEL_MESH_JOIN_TOKEN",
        "requireMtls": true,
        "tailnet": {
          "enabled": false
        }
      },
      "leases": {
        "ttlSeconds": 30
      },
      "replication": {
        "batchSize": 200
      }
    },
    "npu": {
      "enabled": false,
      "autoStart": false,
      "sidecar": {
        "baseUrl": "http://127.0.0.1:11440",
        "command": "python",
        "args": ["apps/npu-sidecar/server.py"],
        "healthPath": "/health",
        "modelsPath": "/v1/models",
        "startTimeoutMs": 20000,
        "requestTimeoutMs": 12000,
        "restartBudget": {
          "windowMs": 60000,
          "maxRestarts": 5,
          "backoffMs": 2000
        }
      }
    },
    "llamaCpp": {
      "enabled": false,
      "autoStart": false,
      "server": {
        "baseUrl": "http://127.0.0.1:8080/v1",
        "command": "llama-server",
        "extraArgs": ["--reasoning", "off"],
        "healthPath": "/health",
        "modelsPath": "/v1/models",
        "startTimeoutMs": 20000,
        "requestTimeoutMs": 12000,
        "restartBudget": {
          "windowMs": 60000,
          "maxRestarts": 5,
          "backoffMs": 2000
        }
      },
      "launch": {
        "alias": "gemma-4-local",
        "ctxSize": 40960,
        "parallel": 1,
        "batchSize": 1024,
        "ubatchSize": 512,
        "flashAttention": true
      }
    },
    "database": {
      "driver": "postgres",
      "postgres": {
        "mode": "bundled",
        "port": 5432,
        "database": "goatcitadel",
        "ssl": "prefer",
        "pool": {
          "min": 0,
          "max": 10,
          "idleTimeoutMs": 30000,
          "connectionTimeoutMs": 10000
        },
        "migrationsTable": "schema_migrations"
      },
      "bundledPostgres": {
        "enabled": true,
        "dataDir": "./data/postgres",
        "port": 55432,
        "autoStart": true,
        "startTimeoutMs": 20000
      },
      "sqlite": {
        "cacheSizeKb": 65536,
        "tempStoreMemory": true,
        "walAutoCheckpointPages": 5000
      }
    },
    "sqlite": {
      "cacheSizeKb": 65536,
      "tempStoreMemory": true,
      "walAutoCheckpointPages": 5000
    },
    "durable": {
      "enabled": true,
      "diagnosticsEnabled": false,
      "executionEnabled": true,
      "chatAutoPromoteEnabled": true,
      "maxAttemptsDefault": 3
    },
    "features": {
      "durableKernelV1Enabled": true,
      "replayOverridesV1Enabled": false,
      "memoryLifecycleAdminV1Enabled": false,
      "memoryLifecycleAutoForgetEnabled": true,
      "memoryMaintenanceV1Enabled": false,
      "connectorDiagnosticsV1Enabled": false,
      "computerUseGuardrailsV1Enabled": true,
      "bankrBuiltinEnabled": false,
      "cronReviewQueueV1Enabled": false,
      "replayRegressionV1Enabled": true
    },
    "budgets": {
      "dailyUsdWarning": 10,
      "dailyUsdHardCap": 50,
      "sessionTokenHardCap": 120000
    }
  },
  "toolPolicy": {
    "profiles": {
      "minimal": ["session.status", "memory.read"],
      "standard": ["session.status", "memory.read", "http.get", "fs.read", "fs.write"],
      "coding": ["session.status", "memory.read", "fs.read", "fs.write", "shell.exec", "git.exec"],
      "ops": ["session.status", "memory.read", "http.get", "http.post", "process.control", "logs.read"],
      "research": [
        "session.status",
        "time.now",
        "memory.read",
        "browser.search",
        "browser.navigate",
        "browser.extract",
        "browser.screenshot",
        "http.get",
        "citations.build"
      ],
      "chat-agent": [
        "session.status",
        "time.now",
        "memory.read",
        "memory.search",
        "memory.write",
        "memory.upsert",
        "browser.search",
        "browser.navigate",
        "browser.extract",
        "http.get",
        "citations.build"
      ],
      "danger": ["*"]
    },
    "tools": {
      "profile": "chat-agent",
      "allow": [],
      "deny": []
    },
    "agents": {},
    "sandbox": {
      "writeJailRoots": ["./workspace", "./data", "./.worktrees"],
      "readOnlyRoots": ["./skills"],
      "readAccessMode": "approval_required",
      "networkAllowlist": [
        "discord.com",
        "chatgpt.com",
        "api.openai.com",
        "api.anthropic.com",
        "generativelanguage.googleapis.com",
        "api.minimax.io",
        "ai-gateway.vercel.sh",
        "openrouter.ai",
        "api.mistral.ai",
        "api.deepseek.com",
        "api.z.ai",
        "api.moonshot.ai",
        "api.perplexity.ai",
        "router.huggingface.co",
        "duckduckgo.com",
        "lite.duckduckgo.com",
        "www.bing.com",
        "www.google.com",
        "127.0.0.1",
        "localhost"
      ],
      "riskyShellPatterns": ["rm", "rmdir", "del", "format", "shutdown", "reboot", "git push", "git reset --hard"],
      "requireApprovalForRiskyShell": true
    }
  },
  "budgets": {
    "mode": "balanced",
    "daily": {
      "tokensWarning": 300000,
      "tokensHardCap": 1000000,
      "usdWarning": 10,
      "usdHardCap": 50
    },
    "session": {
      "tokensHardCap": 120000,
      "turnMaxInputTokens": 32000,
      "turnMaxOutputTokens": 4096
    }
  },
  "llm": {
    "activeProviderId": "",
    "activeModel": "",
    "providers": [
      {
        "providerId": "openai",
        "label": "OpenAI",
        "baseUrl": "https://api.openai.com/v1",
        "apiStyle": "openai-responses",
        "defaultModel": "gpt-5.4-mini",
        "apiKeyEnv": "OPENAI_API_KEY"
      },
      {
        "providerId": "openai-codex",
        "label": "OpenAI Codex (ChatGPT OAuth)",
        "baseUrl": "https://chatgpt.com/backend-api/codex",
        "apiStyle": "openai-codex-responses",
        "defaultModel": "gpt-5.5",
        "authMode": "codex-oauth"
      },
      {
        "providerId": "anthropic",
        "label": "Anthropic",
        "baseUrl": "https://api.anthropic.com/v1",
        "apiStyle": "anthropic-messages",
        "defaultModel": "claude-sonnet-4-6",
        "apiKeyEnv": "ANTHROPIC_API_KEY"
      },
      {
        "providerId": "google",
        "label": "Google (compatible endpoint)",
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "models/gemini-2.5-flash",
        "apiKeyEnv": "GOOGLE_API_KEY"
      },
      {
        "providerId": "minimax",
        "label": "MiniMax (compatible endpoint)",
        "baseUrl": "https://api.minimax.io/v1",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "MiniMax-M2.7",
        "apiKeyEnv": "MINIMAX_API_KEY"
      },
      {
        "providerId": "vercel",
        "label": "Vercel AI Gateway",
        "baseUrl": "https://ai-gateway.vercel.sh/v1",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "openai/gpt-4.1-mini",
        "apiKeyEnv": "VERCEL_AI_GATEWAY_API_KEY"
      },
      {
        "providerId": "openrouter",
        "label": "OpenRouter",
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "openai/gpt-4.1-mini",
        "apiKeyEnv": "OPENROUTER_API_KEY"
      },
      {
        "providerId": "mistral",
        "label": "Mistral",
        "baseUrl": "https://api.mistral.ai/v1",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "mistral-small-latest",
        "apiKeyEnv": "MISTRAL_API_KEY"
      },
      {
        "providerId": "deepseek",
        "label": "DeepSeek",
        "baseUrl": "https://api.deepseek.com/v1",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "deepseek-v4-flash",
        "apiKeyEnv": "DEEPSEEK_API_KEY"
      },
      {
        "providerId": "glm",
        "label": "GLM (Z.AI)",
        "baseUrl": "https://api.z.ai/api/paas/v4",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "glm-5",
        "apiKeyEnv": "GLM_API_KEY"
      },
      {
        "providerId": "moonshot",
        "label": "Moonshot (Kimi API)",
        "baseUrl": "https://api.moonshot.ai/v1",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "kimi-k2.5",
        "apiKeyEnv": "MOONSHOT_API_KEY"
      },
      {
        "providerId": "perplexity",
        "label": "Perplexity",
        "baseUrl": "https://api.perplexity.ai",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "sonar",
        "apiKeyEnv": "PERPLEXITY_API_KEY"
      },
      {
        "providerId": "huggingface",
        "label": "HuggingFace Inference",
        "baseUrl": "https://router.huggingface.co/v1",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "openai/gpt-oss-120b",
        "apiKeyEnv": "HUGGINGFACE_API_KEY"
      },
      {
        "providerId": "llamacpp",
        "label": "llama.cpp",
        "baseUrl": "http://127.0.0.1:8080/v1",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "gemma-4-local"
      },
      {
        "providerId": "localai",
        "label": "LocalAI",
        "baseUrl": "http://127.0.0.1:8080/v1",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "local-model",
        "apiKeyEnv": "LOCALAI_API_KEY"
      },
      {
        "providerId": "ollama",
        "label": "Ollama",
        "baseUrl": "http://127.0.0.1:11434/v1",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "llama3.1"
      },
      {
        "providerId": "lmstudio",
        "label": "LM Studio",
        "baseUrl": "http://127.0.0.1:1234/v1",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "local-model"
      },
      {
        "providerId": "npu-local",
        "label": "NPU Local Sidecar",
        "baseUrl": "http://127.0.0.1:11440/v1",
        "apiStyle": "openai-chat-completions",
        "defaultModel": "phi-3.5-mini-instruct"
      }
    ]
  },
  "cronJobs": {
    "jobs": [
      {
        "jobId": "self_improvement_weekly_replay",
        "name": "Self-Improvement Weekly Replay",
        "schedule": "0 2 * * 0 America/Los_Angeles",
        "enabled": true
      },
      {
        "jobId": "private_beta_backup_daily",
        "name": "Private Beta Daily Backup",
        "schedule": "30 2 * * * America/Los_Angeles",
        "enabled": true
      },
      {
        "jobId": "memory-flush-daily",
        "name": "Memory Flush Daily",
        "schedule": "0 3 * * * America/Los_Angeles",
        "enabled": true
      },
      {
        "jobId": "cost-report-hourly",
        "name": "Cost Report Hourly",
        "schedule": "0 * * * * America/Los_Angeles",
        "enabled": true
      },
      {
        "jobId": "update-review-daily",
        "name": "Daily Update Review",
        "schedule": "15 4 * * * America/Los_Angeles",
        "enabled": true
      }
    ]
  }
}
