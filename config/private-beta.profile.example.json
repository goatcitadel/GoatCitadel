{
  "profileId": "private-beta",
  "description": "Tailnet private-beta hardened defaults (auth + cron posture).",
  "assistant": {
    "auth": {
      "mode": "token",
      "allowLoopbackBypass": false,
      "token": {
        "queryParam": "access_token"
      }
    },
    "features": {
      "computerUseGuardrailsV1Enabled": true
    }
  },
  "cronJobs": {
    "jobs": [
      {
        "jobId": "self_improvement_weekly_replay",
        "name": "Self-Improvement Weekly Replay",
        "action": "improvement",
        "schedule": "0 2 * * 0 America/Los_Angeles",
        "description": "Disabled by default because replay samples chat traces and tool payloads for LLM review. Enable only after operator review of redaction and provider scope.",
        "enabled": false
      },
      {
        "jobId": "private_beta_backup_daily",
        "name": "Private Beta Daily Backup",
        "action": "backup",
        "schedule": "30 2 * * * America/Los_Angeles",
        "enabled": true
      },
      {
        "jobId": "update-review-daily",
        "name": "Daily Update Review",
        "action": "update_review",
        "schedule": "15 4 * * * America/Los_Angeles",
        "enabled": true
      }
    ]
  }
}
