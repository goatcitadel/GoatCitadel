{
  "name": "@goatcitadel/storage",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "goatcitadelOwner": "storage",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@goatcitadel/contracts": "workspace:*",
    "pg": "8.20.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:postgres": "pnpm build && tsx --test \"src/postgres/real-postgres.test.ts\"",
    "test:coverage": "node -e \"const {rmSync}=require('node:fs');rmSync('dist',{recursive:true,force:true});rmSync('tsconfig.tsbuildinfo',{force:true})\" && tsc -b tsconfig.json && c8 --report-dir=coverage --reporter=json --reporter=text-summary node --test \"dist/**/*.test.js\"",
    "lint": "tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  }
}
