{
  "name": "@goatcitadel/storage",
  "version": "1.0.0",
  "goatcitadelOwner": "storage",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@goatcitadel/contracts": "workspace:*",
    "pg": "^8.20.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:postgres": "tsx --test \"src/postgres/real-postgres.test.ts\"",
    "test:coverage": "c8 --report-dir=coverage --reporter=json --reporter=text-summary tsx --test \"src/**/*.test.ts\"",
    "lint": "tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
