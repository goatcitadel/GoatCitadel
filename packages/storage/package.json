{
  "name": "@goatcitadel/storage",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "goatcitadelOwner": "storage",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@goatcitadel/contracts": "workspace:*",
    "pg": "8.20.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "tsx --test --test-concurrency=3 \"src/**/*.test.ts\"",
    "test:postgres": "pnpm build && node --test --test-concurrency=1 --test-reporter=tap \"dist/postgres/real-postgres.test.js\" \"dist/approval-run-linkage.postgres-proof.js\" \"dist/postgres/proof-worker-completion.test.js\" \"dist/mutation-idempotency-dispatch-fence.postgres.test.js\" \"dist/postgres-nesting-transcripts.postgres.test.js\" \"dist/citadel-vault-key-schema.postgres.test.js\" \"dist/citadel-vault-scopes.postgres.test.js\" \"dist/chat-turn-trace-user-message-index.postgres.test.js\" \"dist/change-plan-connector-install.postgres.test.js\" \"dist/chat-tool-run-counts.postgres.test.js\" \"dist/chat-turn-skill-uses.postgres.test.js\" \"dist/integration-plugin-purge-migration.postgres.test.js\" \"dist/change-plan-plugin.postgres.test.js\" \"dist/prompt-pack-delete-cascade.postgres.test.js\"",
    "test:coverage": "node ../../scripts/storage-coverage.mjs",
    "lint": "tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  }
}
