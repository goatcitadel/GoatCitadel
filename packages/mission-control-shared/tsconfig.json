{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"],
    "paths": {
      "react": ["../../node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["../../node_modules/@types/react/jsx-runtime.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.coverage.test.tsx",
    "src/components/OfficeCanvas.tsx",
    "src/components/OfficeCanvasErrorBoundary.tsx",
    "src/components/PixelOfficeCanvas.tsx",
    "src/components/ResizablePaneLayout.tsx",
    "src/components/OperatorSplitLayout.tsx"
  ],
  "references": [{ "path": "../contracts" }]
}
