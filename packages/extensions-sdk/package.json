{
  "name": "@goatcitadel/extensions-sdk",
  "version": "1.0.0",
  "goatcitadelOwner": "extensions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/goatcitadel/GoatCitadel.git",
    "directory": "packages/extensions-sdk"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@goatcitadel/contracts": "workspace:*",
    "zod": "^3.24.1"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "pnpm run clean && tsc -b tsconfig.json --force",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=json --coverage.reporter=text-summary --coverage.reportsDirectory=coverage",
    "lint": "tsc -b tsconfig.json",
    "prepublish:check": "pnpm run lint && pnpm run test && pnpm run build",
    "publish:github:dry-run": "pnpm run prepublish:check && node scripts/publish-github.mjs --dry-run",
    "publish:github": "pnpm run prepublish:check && node scripts/publish-github.mjs"
  }
}
