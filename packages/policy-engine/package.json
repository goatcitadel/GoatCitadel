{
  "name": "@goatcitadel/policy-engine",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "goatcitadelOwner": "policy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "@goatcitadel/contracts": "workspace:*",
    "@goatcitadel/storage": "workspace:*",
    "docx": "9.6.1",
    "mammoth": "1.12.0",
    "playwright": "1.58.2",
    "pptxgenjs": "4.0.1",
    "sharp": "0.35.3",
    "undici": "6.27.0",
    "unpdf": "1.6.2"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=json --coverage.reporter=text-summary --coverage.reportsDirectory=coverage",
    "lint": "tsc -b tsconfig.json"
  }
}
