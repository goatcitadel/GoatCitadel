{
  "name": "goatcitadel",
  "private": true,
  "version": "0.1.0-rc.1",
  "packageManager": "pnpm@10.31.0",
  "bin": {
    "goatcitadel": "./bin/goatcitadel.mjs",
    "goat": "./bin/goatcitadel.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "up": "pnpm dev:all",
    "launch": "node bin/goatcitadel.mjs launch",
    "desktop:dev": "pnpm --filter @goatcitadel/mission-control-desktop dev:desktop",
    "desktop:build": "pnpm --filter @goatcitadel/mission-control-desktop build:desktop",
    "windows:dev": "dotnet run --project apps/mission-control-windows/GoatCitadel.MissionControl.Windows.csproj",
    "windows:test": "dotnet test apps/mission-control-windows/Tests/GoatCitadel.MissionControl.Windows.Tests.csproj -p:RestoreSources=https://api.nuget.org/v3/index.json --blame-hang --blame-hang-timeout 10m --blame-hang-dump-type none",
    "package:bundle": "node scripts/packaging/build-bundle.mjs",
    "package:desktop": "node scripts/packaging/build-desktop.mjs",
    "package:windows-host": "node scripts/packaging/build-windows-host.mjs",
    "package:windows-msix": "node scripts/packaging/build-windows-msix.mjs",
    "package:windows": "node scripts/packaging/build-windows-native-installer.mjs",
    "package:macos": "node scripts/packaging/build-macos-native-installer.mjs",
    "macos:desktop:evidence": "node scripts/packaging/collect-macos-desktop-evidence.mjs",
    "package:windows:bootstrap": "node scripts/packaging/build-windows-bootstrap.mjs",
    "dev:gateway": "pnpm --filter @goatcitadel/gateway dev",
    "dev:gateway:watch": "pnpm --filter @goatcitadel/gateway dev:watch",
    "dev:ui": "pnpm --filter @goatcitadel/mission-control-next dev",
    "dev:ui:current": "pnpm --filter @goatcitadel/mission-control-next dev",
    "dev:ui:next": "pnpm --filter @goatcitadel/mission-control-next dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "smoke": "pnpm --filter @goatcitadel/gateway smoke",
    "onboarding:tui": "pnpm --filter @goatcitadel/gateway onboarding:tui",
    "tui": "pnpm --filter @goatcitadel/gateway tui",
    "doctor": "pnpm --filter @goatcitadel/gateway run doctor",
    "doctor:deep": "pnpm --filter @goatcitadel/gateway run doctor --deep",
    "doctor:audit": "pnpm --filter @goatcitadel/gateway run doctor --deep --audit-only",
    "tools": "pnpm --filter @goatcitadel/gateway tools",
    "admin": "pnpm --filter @goatcitadel/gateway admin",
    "brand:derive": "node scripts/brand/derive-assets.mjs",
    "config:sync": "pnpm --filter @goatcitadel/gateway config:sync",
    "llm:sync-models": "node scripts/sync-llm-models.mjs",
    "prompt:gates": "pnpm tsx scripts/run-prompt-pack-gates.ts",
    "prompt:gates:targeted": "pnpm tsx scripts/run-prompt-pack-gates.ts --target-only",
    "screenshots:capture": "pnpm --filter @goatcitadel/policy-engine exec node scripts/capture-mission-control-screenshots.mjs",
    "inventory:inline-sql": "node scripts/inventory-inline-sql.mjs",
    "dependency:risk": "node scripts/dependency-risk-report.mjs",
    "coverage:collect": "node scripts/coverage-collect.mjs",
    "coverage:uncovered": "node scripts/coverage-uncovered-lines.mjs",
    "coverage:gate": "node scripts/coverage-gate.mjs",
    "coverage:gate:production": "node scripts/coverage-gate.mjs --profile=production",
    "coverage:gate:line100": "node scripts/coverage-gate.mjs --profile=line100",
    "coverage:gate:strict100": "node scripts/coverage-gate.mjs --profile=strict100",
    "docs:check": "node scripts/validate-governance-docs.mjs && node scripts/check-button-types.mjs && node scripts/check-no-inline-sql.mjs && node scripts/check-memory-ownership.mjs && node scripts/check-bounded-response-reads.mjs && node scripts/check-no-empty-catch.mjs && node scripts/check-launcher-ui-target.mjs && node scripts/check-docker-secret-docs.mjs && node scripts/check-release-proof-tag-glob.mjs && pnpm check:docker-secrets",
    "verify:repo:hygiene": "node --test scripts/verify-repo-hygiene.test.mjs scripts/verify-supply-chain-posture.test.mjs scripts/check-button-types.test.mjs scripts/packaging/macos-packaging.test.mjs scripts/packaging/safe-cleanup.test.mjs scripts/release/release-certificate-proof.test.mjs scripts/verification/lib/scenarios.test.mjs && node scripts/verify-repo-hygiene.mjs && node scripts/verify-supply-chain-posture.mjs",
    "verify:supply-chain": "node --test scripts/verify-supply-chain-posture.test.mjs && node scripts/verify-supply-chain-posture.mjs",
    "verify:design:quality": "pnpm tsx scripts/verify-design-quality.ts",
    "verify:skills:catalog": "node scripts/check-skill-catalog.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "verify:security:evals": "node scripts/verification/run.mjs security-evals",
    "verify:artifacts:redaction": "node --test scripts/verify-artifact-redaction.test.mjs && node scripts/verify-artifact-redaction.mjs",
    "verify:storage:migration-parity": "node --test scripts/verify-storage-migration-parity.test.mjs && node scripts/verify-storage-migration-parity.mjs",
    "check:buttons": "node scripts/check-button-types.mjs",
    "check:launcher": "node scripts/check-launcher-ui-target.mjs",
    "check:docker-secrets": "node --test scripts/docker-secrets.test.mjs",
    "check:bounded-response-reads": "node --test scripts/check-bounded-response-reads.test.mjs && node scripts/check-bounded-response-reads.mjs",
    "secrets:docker": "node scripts/generate-docker-secrets.mjs --docker-env",
    "release:extensions-sdk:dry-run": "pnpm --filter @goatcitadel/extensions-sdk publish:github:dry-run",
    "release:extensions-sdk": "pnpm --filter @goatcitadel/extensions-sdk publish:github",
    "verify:extensions:package": "pnpm --filter @goatcitadel/extensions-sdk build && node scripts/verify-extension-package-artifacts.mjs",
    "verify:extensions:package:from-build": "node scripts/verify-extension-package-artifacts.mjs",
    "verify:mcp:conformance": "node --test scripts/mcp-conformance.test.mjs scripts/mcp-server-stdio-runner.test.mjs",
    "verify:fast": "node scripts/verification/run.mjs fast",
    "verify:a2a:full": "node scripts/verification/run.mjs a2a-full",
    "verify:deep:core": "node scripts/verification/run.mjs deep-core",
    "verify:deep:ecosystem": "node scripts/verification/run.mjs deep-ecosystem",
    "verify:catalog:parity": "node scripts/verification/run.mjs catalog-parity",
    "verify:api:compat": "node scripts/verification/run.mjs api-compat",
    "verify:operator:proof": "node scripts/verification/run.mjs operator-proof",
    "verify:durable:recovery": "node scripts/verification/run.mjs durable-recovery",
    "verify:runtime:truth": "node scripts/verification/run.mjs runtime-truth",
    "verify:orchestration:perf": "corepack pnpm --filter @goatcitadel/gateway exec tsx src/orchestration/performance-gates-cli.ts",
    "verify:auth:matrix": "node scripts/verification/run.mjs auth-matrix",
    "verify:ui:parity": "node scripts/verification/run.mjs ui-parity",
    "verify:memory:truth": "node scripts/verification/run.mjs memory-truth",
    "verify:realtime:truth": "node scripts/verification/run.mjs realtime-truth",
    "verify:architecture:metrics": "node scripts/verification/run.mjs architecture-metrics",
    "verify:code-mode:sandbox": "node scripts/verification/run.mjs code-mode-sandbox",
    "verify:code-mode:hostile-sandbox": "node scripts/verification/run.mjs code-mode-hostile-sandbox",
    "verify:mesh:readiness": "node scripts/verification/run.mjs mesh-readiness",
    "verify:agentic:contracts": "node scripts/verification/run.mjs agentic-contracts",
    "verify:agentic:governance": "node scripts/verification/run.mjs agentic-governance",
    "verify:agentic:harnesses": "node scripts/verification/run.mjs agentic-harnesses",
    "verify:agentic:proof": "node scripts/verification/run.mjs agentic-proof",
    "verify:agentic:parity": "node scripts/verification/run.mjs agentic-parity",
    "verify:harness:availability": "node scripts/verification/run.mjs agentic-harness-availability",
    "verify:plugins:marketplace": "node scripts/verification/run.mjs agentic-plugins-marketplace",
    "verify:self-improvement:trust": "node scripts/verification/run.mjs agentic-self-improvement-trust",
    "verify:channels:runtime": "node scripts/verification/run.mjs agentic-channels-runtime",
    "verify:code:workbench-loop": "node scripts/verification/run.mjs agentic-workbench-loop",
    "verify:surface:regression": "node scripts/verification/run.mjs surface-regression",
    "verify:visual:regression": "node scripts/verification/run.mjs visual-regression",
    "verify:visual:rebaseline": "node scripts/verification/run.mjs visual-rebaseline",
    "verify:backup:roundtrip": "node scripts/verification/run.mjs backup-roundtrip",
    "verify:soak": "node scripts/verification/run.mjs soak",
    "verify:review": "node scripts/verification/run.mjs review",
    "verify:all": "node scripts/verification/run.mjs all",
    "verify:install": "node scripts/verify-install.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "security:trivy": "node scripts/trivy-scan.mjs .",
    "check:legacy:next": "pnpm --filter @goatcitadel/mission-control-next legacy:check",
    "perf:check:next": "pnpm --filter @goatcitadel/mission-control-next perf:check",
    "ts7:toolchain": "node scripts/typescript/assert-ts7-toolchain.mjs",
    "ts7:typecheck": "node scripts/typescript/run-ts7-workspace.mjs --mode typecheck",
    "ts7:build": "node scripts/typescript/run-ts7-workspace.mjs --mode build",
    "ts7:benchmark": "node scripts/typescript/benchmark-ts7.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "@webgpu/types": "link:vendor/webgpu-types-stub",
      "brace-expansion@^2.0.2": "2.0.3",
      "brace-expansion@^5.0.0": "5.0.6",
      "dompurify": "3.4.11",
      "esbuild": "0.28.1",
      "express-rate-limit@8.3.2>ip-address": "10.1.1",
      "fast-uri": "3.1.2",
      "hono": "4.12.25",
      "lodash": "4.18.1",
      "postcss": "8.5.10",
      "qs": "6.15.2",
      "undici": "6.27.0",
      "uuid": "14.0.0",
      "ws@^8.0.0": "8.21.0",
      "@babel/core@^7.0.0": "7.29.6",
      "js-yaml@^4.0.0": "4.2.0",
      "protobufjs@^7.0.0": "7.6.3",
      "vite@^6.0.0": "6.4.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.8",
    "c8": "10.1.3",
    "eslint": "10.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "playwright": "1.58.2",
    "prettier": "3.8.3",
    "sharp": "0.34.5",
    "tsx": "4.22.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.58.0",
    "vitest": "4.1.8",
    "zod": "3.25.76"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "shell-quote": "1.8.4"
  }
}
