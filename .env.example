NODE_ENV=development
GATEWAY_PORT=8787
GATEWAY_HOST=127.0.0.1
MISSION_CONTROL_ORIGIN=http://localhost:5173
DATA_DIR=./data
WORKSPACE_DIR=./workspace

# Provider API keys shown in Settings > Providers & Models.
# Values are loaded by the gateway and are never returned to the browser.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Long-lived Claude subscription token from `claude setup-token`.
# Used by the Claude Code provider; unlike ANTHROPIC_API_KEY, this is sent as Bearer OAuth.
CLAUDE_CODE_OAUTH_TOKEN=
GOOGLE_API_KEY=
GLM_API_KEY=
MOONSHOT_API_KEY=
PERPLEXITY_API_KEY=

# Optional browser/research integration settings exposed by the UI.
# FIRECRAWL_API_KEY and FIRECRAWL_KEY are the safe built-in lookup names.
# GOATCITADEL_FIRECRAWL_API_KEY_ENV may point at one of those safe names.
# FIRECRAWL_API_KEY=
# FIRECRAWL_KEY=
# GOATCITADEL_FIRECRAWL_API_KEY_ENV=FIRECRAWL_API_KEY
# GOATCITADEL_FIRECRAWL_DEFAULT_READ_BACKEND=firecrawl
# GOATCITADEL_FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# GOATCITADEL_FIRECRAWL_ENABLED=true

# Optional governed Code Mode Docker backend overrides.
# GOATCITADEL_CODE_MODE_DOCKER_BACKEND_ENABLED=false
# GOATCITADEL_CODE_MODE_DOCKER_IMAGE=ghcr.io/goatcitadel/code-mode-runner@sha256:replace-with-image-digest
# GOATCITADEL_CODE_MODE_DOCKER_REQUIRE_DIGEST=true

# Optional database overrides
# GOATCITADEL_DATABASE_DRIVER=postgres
# GOATCITADEL_POSTGRES_MODE=bundled
# GOATCITADEL_POSTGRES_HOST=127.0.0.1
# GOATCITADEL_POSTGRES_PORT=55432
# GOATCITADEL_POSTGRES_DATABASE=goatcitadel
# GOATCITADEL_POSTGRES_USER=postgres
# GOATCITADEL_POSTGRES_PASSWORD=
# GOATCITADEL_POSTGRES_SSL=prefer
# GOATCITADEL_BUNDLED_POSTGRES_ENABLED=true

# Optional auth overrides (configure via Mission Control Forge tab for persistence)
# GOATCITADEL_AUTH_MODE=token
# GOATCITADEL_AUTH_TOKEN=replace-with-strong-token
# GOATCITADEL_AUTH_BASIC_USERNAME=operator
# GOATCITADEL_AUTH_BASIC_PASSWORD=replace-with-strong-password
# GOATCITADEL_AUTH_ALLOW_LOOPBACK_BYPASS=false
# GOATCITADEL_WARN_UNAUTH_NON_LOOPBACK=true # keep startup warnings on when testing bind/auth posture
# GOATCITADEL_ALLOW_UNAUTH_NETWORK=1 # insecure override, only for isolated local debugging
# GOATCITADEL_ALLOW_REMOTE_APPROVAL_CREATE=1 # insecure override, enables remote synthetic approvals

# Optional mesh overrides (LAN-first, disabled by default)
# GOATCITADEL_MESH_ENABLED=true
# GOATCITADEL_MESH_MODE=lan
# GOATCITADEL_MESH_NODE_ID=my-node-01
# GOATCITADEL_MESH_JOIN_TOKEN=replace-with-join-token

# Optional llama.cpp overrides
# GOATCITADEL_LLAMACPP_ENABLED=true
# GOATCITADEL_LLAMACPP_AUTOSTART=false
# GOATCITADEL_LLAMACPP_URL=http://127.0.0.1:8080/v1
# GOATCITADEL_LLAMACPP_COMMAND=llama-server
# GOATCITADEL_LLAMACPP_MODELS_ROOT=C:\models
# GOATCITADEL_LLAMACPP_MODEL_PATH=C:\models\Gemma-E4B-Opus\gemma-4-E4B-it-Q8_0.gguf

# Advanced local voice runtime overrides (managed whisper.cpp is the default path)
# GOATCITADEL_WHISPER_CPP_BIN=
# GOATCITADEL_WHISPER_CPP_MODEL_PATH=
# GOATCITADEL_WHISPER_CPP_ARGS=
# GOATCITADEL_FFMPEG_BIN=

# Private beta (Tailnet) hardened profile
# GOATCITADEL_AUTH_MODE=token
# GOATCITADEL_AUTH_TOKEN=replace-with-long-random-token
# GOATCITADEL_AUTH_ALLOW_LOOPBACK_BYPASS=false
# GOATCITADEL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://bld:5173,https://bld.ts.net
# GOATCITADEL_VITE_ALLOWED_HOSTS=localhost,127.0.0.1,bld,.ts.net
# VITE_GATEWAY_ALLOWED_HOSTS=localhost,127.0.0.1,bld,.ts.net
