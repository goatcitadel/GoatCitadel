<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GoatCitadel.MissionControl.Windows</RootNamespace>
    <AssemblyName>GoatCitadel-Mission-Control-Windows</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by `pnpm brand:derive`; gives the exe (and every shortcut to it) the GoatCitadel mark. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(RuntimeIdentifier)' != ''">true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\tray.ico" LogicalName="GoatCitadel.MissionControl.Windows.Assets.tray.ico" />
  </ItemGroup>

  <!-- AppNotificationManager.Register loads this DLL beside the executable.
       The self-contained SDK 2.x targets omit it from the framework MSIX
       (microsoft/WindowsAppSDK#6774). Use the pinned SDK's matching architecture. -->
  <Target Name="_IncludeWindowsNotificationResource"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="GetWindowsAppSDKNativePlatform"
          Condition="'$(WindowsAppSDKSelfContained)' == 'true' and '$(WindowsPackageType)' == 'None'">
    <PropertyGroup>
      <_NotificationResourceName>Microsoft.WindowsAppRuntime.Insights.Resource.dll</_NotificationResourceName>
      <_NotificationFrameworkArchive>$(MicrosoftWindowsAppSDKPackageDir)tools\MSIX\win10-$(NativePlatform)\Microsoft.WindowsAppRuntime.2.msix</_NotificationFrameworkArchive>
      <_NotificationResourceDirectory>$(IntermediateOutputPath)notification-resource\</_NotificationResourceDirectory>
      <_NotificationResourcePath>$(_NotificationResourceDirectory)$(_NotificationResourceName)</_NotificationResourcePath>
    </PropertyGroup>
    <Error Condition="!Exists('$(_NotificationFrameworkArchive)')"
           Text="Cannot include the Windows notification resource. The matching Windows App SDK framework archive is missing." />
    <Unzip SourceFiles="$(_NotificationFrameworkArchive)"
           DestinationFolder="$(_NotificationResourceDirectory)"
           Include="$(_NotificationResourceName)" />
    <Error Condition="!Exists('$(_NotificationResourcePath)')"
           Text="The Windows App SDK framework archive does not contain $(_NotificationResourceName)." />
    <ItemGroup>
      <None Include="$(_NotificationResourcePath)"
            Link="$(_NotificationResourceName)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    WinUI 3 unpackaged publish fix.
    `dotnet build` generates the app resource index ($(AssemblyName).pri) and compiled XAML
    (*.xbf) into $(OutDir), but `dotnet publish` (self-contained, WindowsPackageType=None) does
    not reliably copy the app PRI into the publish output. Without it the shipped app cannot
    load App.xaml's resources and crashes at startup with 0xC000027B (STATUS_STOWED_EXCEPTION)
    inside Microsoft.UI.Xaml.dll. Copy the app PRI into the publish output under the
    runtime-expected name `resources.pri`, plus the compiled XAML. Implemented as a post-publish
    file copy so it stays correct across SDK versions (some already publish the .xbf, some drop
    them) without tripping NETSDK1152 duplicate-path errors.
  -->
  <Target Name="_CopyWinUiAppResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUiAppXbf Include="$(OutDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri"
          DestinationFiles="$([System.IO.Path]::Combine('$(PublishDir)', 'resources.pri'))"
          Condition="Exists('$(OutDir)$(AssemblyName).pri')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUiAppXbf)"
          DestinationFolder="$(PublishDir)"
          Condition="'@(_WinUiAppXbf)' != ''"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
