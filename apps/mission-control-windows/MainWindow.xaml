<Window
    x:Class="GoatCitadel.MissionControl.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="GoatCitadel Mission Control">
    <Grid Background="#081015">
        <controls:WebView2
            x:Name="MissionWebView"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <Grid x:Name="StartupPanel" Padding="32">
            <Border
                MaxWidth="720"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#101A20"
                BorderBrush="#1C3D44"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="14" Height="42" Background="#00D7C8" CornerRadius="3" />
                        <StackPanel>
                            <TextBlock
                                Foreground="#7EE8DF"
                                FontSize="13"
                                Text="GoatCitadel" />
                            <TextBlock
                                Foreground="#F4FBFC"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Text="Mission Control" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        x:Name="StatusCopy"
                        Foreground="#F4FBFC"
                        FontSize="18"
                        Text="Starting the local runtime..."
                        TextWrapping="Wrap" />
                    <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="42" />
                    <TextBlock
                        x:Name="RuntimeMeta"
                        Foreground="#B8CED2"
                        FontSize="13"
                        Text="Gateway and Mission Control will stay warm while the desktop app is open."
                        TextWrapping="Wrap" />

                    <StackPanel
                        x:Name="RecoveryActions"
                        Orientation="Horizontal"
                        Spacing="10"
                        Visibility="Collapsed">
                        <Button x:Name="RetryButton" Click="RetryButton_Click" Content="Retry" />
                        <Button x:Name="OpenBrowserButton" Click="OpenBrowserButton_Click" Content="Open in Browser" />
                        <Button x:Name="OpenLogsButton" Click="OpenLogsButton_Click" Content="Open Logs" />
                        <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" Content="Open Install Folder" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <InfoBar
            x:Name="DesktopToast"
            Margin="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsOpen="False"
            IsClosable="False"
            Severity="Informational" />
    </Grid>
</Window>
