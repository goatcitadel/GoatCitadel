<Window
    x:Class="GoatCitadel.MissionControl.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="GoatCitadel Mission Control">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:WebView2
            x:Name="MissionWebView"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <Grid x:Name="StartupPanel" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
            <Border
                MaxWidth="640"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="14" Height="42" Background="{ThemeResource GoatAccentBrush}" CornerRadius="3" />
                        <StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource GoatAccentBrush}"
                                FontSize="13"
                                Text="GoatCitadel" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Text="Mission Control" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        x:Name="StatusCopy"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        FontSize="18"
                        Text="Starting the local runtime..."
                        TextWrapping="Wrap" />
                    <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" AutomationProperties.Name="Starting local runtime" />
                    <Button Click="CheckUpdatesButton_Click" Content="Check for updates" />
                    <Expander Header="Runtime details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock
                                x:Name="RuntimeMeta"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="13"
                                Text="Gateway and Mission Control will stay warm while the desktop app is open."
                                TextWrapping="Wrap" />
                            <Button x:Name="ProfileRecoveryButton" Visibility="Collapsed"
                                Click="ProfileRecoveryButton_Click" Content="Reset and restore…" />
                        </StackPanel>
                    </Expander>

                    <Grid x:Name="RecoveryActions" Visibility="Collapsed" ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="RetryButton" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Click="RetryButton_Click" Content="Retry" />
                        <Button x:Name="OpenBrowserButton" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Click="OpenBrowserButton_Click" Content="Open in Browser" />
                        <Button x:Name="OpenLogsButton" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Click="OpenLogsButton_Click" Content="Open Logs" />
                        <Button x:Name="OpenFolderButton" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Click="OpenFolderButton_Click" Content="Open Install Folder" />
                    </Grid>
                </StackPanel>
            </Border>
            </ScrollViewer>
        </Grid>

        <Border x:Name="StartupDraftPanel" Grid.Row="1" Visibility="Collapsed"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="24,12">
            <StackPanel Spacing="8" MaxWidth="640" HorizontalAlignment="Stretch">
                <TextBox x:Name="StartupDraftBox" Header="Chat draft" AutomationProperties.Name="Chat draft"
                    AutomationProperties.AutomationId="StartupDraftBox"
                    PlaceholderText="Start typing your message" AcceptsReturn="True" TextWrapping="Wrap"
                    MaxHeight="120" MaxLength="16384"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <TextBlock x:Name="StartupDraftStatus" AutomationProperties.LiveSetting="Polite"
                    Text="Your draft stays here until Chat is ready." TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="StartupDraftInsert" Content="Append to Chat" IsEnabled="False"
                        AutomationProperties.AutomationId="StartupDraftInsert"
                        Click="StartupDraftInsert_Click" />
                    <Button x:Name="StartupDraftDiscard" Content="Discard draft" IsEnabled="False"
                        Click="StartupDraftDiscard_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <InfoBar
            x:Name="DesktopToast"
            Margin="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsOpen="False"
            IsClosable="False"
            Severity="Informational" />
    </Grid>
</Window>
