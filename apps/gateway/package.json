{
  "name": "@goatcitadel/gateway",
  "version": "1.0.0",
  "goatcitadelOwner": "runtime",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "goatcitadel-admin": "dist/admin-cli.js",
    "goatcitadel-cron": "dist/cron-cli.js",
    "goatcitadel-session-control": "dist/session-control-cli.js"
  },
  "dependencies": {
    "@fastify/cors": "10.1.0",
    "@fastify/rate-limit": "10.3.0",
    "@goatcitadel/contracts": "workspace:*",
    "@goatcitadel/extensions-sdk": "workspace:*",
    "@goatcitadel/gateway-core": "workspace:*",
    "@goatcitadel/memory-core": "workspace:*",
    "@goatcitadel/mesh-core": "workspace:*",
    "@goatcitadel/mission-control-shared": "workspace:*",
    "@goatcitadel/orchestration": "workspace:*",
    "@goatcitadel/policy-engine": "workspace:*",
    "@goatcitadel/skills": "workspace:*",
    "@goatcitadel/storage": "workspace:*",
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@inquirer/prompts": "7.10.1",
    "@sigstore/bundle": "4.0.0",
    "@sigstore/protobuf-specs": "0.5.1",
    "@sigstore/tuf": "4.0.2",
    "@sigstore/verify": "3.1.1",
    "adm-zip": "0.6.0",
    "chalk": "5.6.2",
    "discord.js": "14.25.1",
    "fastify": "5.8.5",
    "fastify-plugin": "5.1.0",
    "ora": "9.3.0",
    "pg": "8.20.0",
    "shell-quote": "1.9.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "undici": "6.27.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/shell-quote": "1.7.5"
  },
  "scripts": {
    "dev": "tsx src/dev-supervisor.ts",
    "dev:watch": "tsx src/dev-supervisor.ts",
    "dev:supervisor": "tsx src/dev-supervisor.ts",
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "pretest": "node ../../scripts/run-unless-env.mjs GOATCITADEL_SKIP_EXTENSIONS_SDK_PREBUILD pnpm --filter @goatcitadel/extensions-sdk build",
    "test": "vitest run && tsx --test src/services/chat-generated-artifact-service.test.ts src/services/chat-thread-knowledge-service.test.ts",
    "test:postgres:auth": "vitest run src/services/settings-auth-service.test.ts",
    "pretest:postgres:memory": "pnpm --filter @goatcitadel/storage build",
    "test:postgres:memory": "vitest run src/services/memory-lifecycle-service.real-postgres.test.ts",
    "test:improvement-ledger": "tsx --test src/services/improvement-service.node.test.ts src/improvement-operator-proof.node.test.ts",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=json --coverage.reporter=text-summary --coverage.reportsDirectory=coverage",
    "coverage:smoke": "c8 --report-dir=coverage-smoke --reporter=json tsx src/coverage-smoke.ts",
    "coverage:exercise": "c8 --report-dir=coverage-exercise --reporter=json tsx src/coverage-exercise.ts",
    "presmoke": "node ../../scripts/run-unless-env.mjs GOATCITADEL_SKIP_EXTENSIONS_SDK_PREBUILD pnpm --filter @goatcitadel/extensions-sdk build",
    "smoke": "tsx src/smoke.ts",
    "onboarding:tui": "tsx src/onboarding-tui.ts",
    "tui": "tsx src/tui/main.ts",
    "doctor": "tsx src/doctor/cli.ts",
    "tools": "tsx src/tui/tools-cli.ts",
    "voice:runtime": "tsx src/voice-runtime-cli.ts",
    "admin": "tsx src/admin-cli.ts",
    "session-control": "tsx src/session-control-cli.ts",
    "config:sync": "tsx src/config-sync.ts",
    "lint": "tsc -b tsconfig.json"
  }
}
