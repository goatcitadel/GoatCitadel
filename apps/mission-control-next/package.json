{
  "name": "@goatcitadel/mission-control-next",
  "version": "1.0.0",
  "goatcitadelOwner": "mission-control",
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter @goatcitadel/mission-control-shared build && pnpm --filter @goatcitadel/threaded-surface-core build",
    "predev": "pnpm run build:deps",
    "dev": "vite",
    "build": "pnpm run build:deps && tsc -b tsconfig.json tsconfig.node.json && vite build",
    "legacy:check": "node ../../scripts/check-mission-control-next-legacy-usage.mjs",
    "tokens:check": "node ../../scripts/check-mission-control-next-token-drift.mjs",
    "typography:check": "node ../../scripts/check-mission-control-next-typography.mjs",
    "contrast:check": "node ../../scripts/check-mission-control-next-contrast.mjs",
    "buttons:check": "node ../../scripts/check-mission-control-next-buttons.mjs",
    "icons:check": "node ../../scripts/check-mission-control-next-icon-sizing.mjs",
    "perf:check": "node ../../scripts/check-mission-control-next-legacy-usage.mjs && node ../../scripts/check-mission-control-next-token-drift.mjs && node ../../scripts/check-mission-control-next-typography.mjs && node ../../scripts/check-mission-control-next-buttons.mjs && node ../../scripts/check-mission-control-next-icon-sizing.mjs && node ../../scripts/check-mission-control-next-contrast.mjs && node ../../scripts/check-mission-control-next-budgets.mjs",
    "preview": "vite preview",
    "typecheck": "pnpm run build:deps && tsc -b tsconfig.json tsconfig.node.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=json --coverage.reporter=text-summary --coverage.reportsDirectory=coverage",
    "lint": "pnpm run build:deps && tsc -b tsconfig.json tsconfig.node.json"
  },
  "dependencies": {
    "@assistant-ui/react": "0.12.25",
    "@assistant-ui/react-markdown": "0.12.9",
    "@fontsource-variable/geist": "5.2.8",
    "@goatcitadel/contracts": "workspace:*",
    "@goatcitadel/mission-control-shared": "workspace:*",
    "@goatcitadel/threaded-surface-core": "workspace:*",
    "@monaco-editor/loader": "1.7.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/react-table": "8.21.3",
    "@uiw/react-monacoeditor": "3.6.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "0.542.0",
    "mermaid": "11.15.0",
    "monaco-editor": "0.55.1",
    "next-themes": "0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.2.5",
    "react-arborist": "3.5.0",
    "react-dom": "19.2.5",
    "react-markdown": "10.1.0",
    "react-reflex": "5.0.5",
    "react-virtuoso": "4.18.3",
    "remark-gfm": "4.0.1",
    "shadcn": "4.2.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "@vitejs/plugin-react": "4.7.0",
    "happy-dom": "20.9.0",
    "react-test-renderer": "19.2.5",
    "vite": "6.4.3"
  }
}
