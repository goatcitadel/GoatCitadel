{
  "name": "@goatcitadel/mission-control-desktop",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "goatcitadelOwner": "desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "dev:desktop": "tauri dev",
    "build": "tsc -p tsconfig.json && vite build",
    "build:desktop": "pnpm build && tauri build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=json --coverage.reporter=text-summary --coverage.reportsDirectory=coverage --coverage.reportOnFailure"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-notification": "2.3.3"
  },
  "devDependencies": {
    "happy-dom": "20.9.0",
    "@tauri-apps/cli": "2.11.0",
    "vite": "6.4.3",
    "vitest": "4.1.8"
  }
}
